---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import Tr from '../components/Tr.astro';
import { site } from '../config.js';

const s = site.support || {};
const hasAny = s.duitnowQr || s.kofi || s.bankNote;
---

<Base title="支持我们" description={`支持 ${site.name} —— 公民教育内容永远免费`}>
  <div class="wrap-read">
    <header class="page-hero">
      <span class="hero-kicker"><Tr zh="支持我们 · SUPPORT" en="SUPPORT" /></span>
      <h1><Tr zh="请我们喝杯咖啡 ☕" en="Buy us a coffee ☕" /></h1>
      <p class="page-hero-lead">
        <Tr
          zh="所有公民教育内容永远免费、对所有人开放。如果它帮到了你，一点点支持能让我们继续做下去——制作、查证、翻译都需要时间。"
          en="All our civic education stays free and open to everyone. If it helped you, a small gift keeps us going — writing, fact-checking and translating all take time."
        />
      </p>
    </header>

    {hasAny ? (
      <div class="support-grid">
        {s.duitnowQr && (
          <div class="support-card">
            <h3><Tr zh="DuitNow QR" en="DuitNow QR" /></h3>
            <img class="support-qr" src={s.duitnowQr} alt="DuitNow QR" />
            <p class="support-hint"><Tr zh="用任何银行 / 电子钱包 App 扫码，金额随心。" en="Scan with any bank or e-wallet app — any amount." /></p>
          </div>
        )}
        {s.kofi && (
          <div class="support-card">
            <h3><Tr zh="国际卡 / PayPal" en="Card / PayPal" /></h3>
            <p class="support-hint"><Tr zh="在马来西亚以外，或想用信用卡支持？" en="Outside Malaysia, or prefer card?" /></p>
            <a class="support-btn" href={s.kofi} target="_blank" rel="noopener">
              <Tr zh="到 Ko-fi 支持 →" en="Support on Ko-fi →" />
            </a>
          </div>
        )}
        {s.bankNote && (
          <div class="support-card">
            <h3><Tr zh="银行转账" en="Bank transfer" /></h3>
            <p class="support-hint" style="white-space:pre-line">{s.bankNote}</p>
          </div>
        )}
      </div>
    ) : (
      <div class="notice" style="margin-top:1.6rem">
        <Tr
          zh="收款入口即将开放。想第一时间支持我们？先订阅吧 👇"
          en="Donation options are coming soon. Want to support us first? Subscribe below 👇"
        />
      </div>
    )}

    <!-- 资金来源 / 中立声明 —— 公信力的底线 -->
    <section class="trust-box">
      <h2 class="section-title" style="margin-top:0"><Tr zh="我们的中立承诺" en="Our neutrality promise" /></h2>
      <ul class="trust-list">
        <li><span class="check">✓</span> <Tr zh="我们不接受任何政党、政治人物或候选人的资助来影响内容。" en="We accept no funding from any party, politician or candidate to shape our content." /></li>
        <li><span class="check">✓</span> <Tr zh="核心公民知识——宪法、权利、投票流程——永远免费、不设付费墙。" en="Core civic knowledge — the Constitution, your rights, how to vote — stays free, never paywalled." /></li>
        <li><span class="check">✓</span> <Tr zh="任何赞助或合作内容都会清楚标注，资金来源公开透明。" en="Any sponsored or partnered content is clearly labelled, and our funding is transparent." /></li>
        <li><span class="check">✓</span> <Tr zh="你的支持帮助我们保持独立——只对读者负责。" en="Your support keeps us independent — accountable only to readers." /></li>
      </ul>
    </section>

    <Subscribe />
  </div>
</Base>
