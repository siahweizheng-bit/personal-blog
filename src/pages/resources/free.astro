---
import Base from '../../layouts/Base.astro';
import Tr from '../../components/Tr.astro';
import { site } from '../../config.js';

const all = site.products || [];
const freeP = all.filter((p) => p.status === 'free');
const isImg = (c) => typeof c === 'string' && c.startsWith('/');
const endpoint = site.subscribe?.endpoint || '';
---

<Base title="免费资源" description="公民白话文免费 PDF 下载">
  <div class="wrap">

    <!-- 面包屑 -->
    <nav class="breadcrumb" style="padding-top:1.4rem">
      <a href="/resources"><Tr zh="资源" en="Resources" /></a>
      <span class="bc-sep">／</span>
      <span class="bc-current"><Tr zh="免费资源" en="Free resources" /></span>
    </nav>

    <header class="res-hero reveal">
      <span class="res-sub-badge free-badge">📥 <Tr zh="免费下载" en="Free downloads" /></span>
      <h1><Tr zh="免费资源" en="Free resources" /></h1>
      <p><Tr
        zh="这些 PDF 完全免费——留下名字与邮箱，立即解锁下载。中英双版，事实经官方来源核实。"
        en="These PDFs are completely free — enter your name and email to unlock the download. Bilingual, facts verified against official sources." /></p>
    </header>

    {freeP.length > 0 ? (
      <div class="res-grid reveal">
        {freeP.map((p) => (
          <article class="rcard">
            <div class="rcard-cover">
              {isImg(p.cover) ? <img src={p.cover} alt={p.title} /> : <span class="rcard-emoji">{p.cover}</span>}
              <span class="rcard-badge free"><Tr zh="免费" en="Free" /></span>
            </div>
            <div class="rcard-body">
              <h3><Tr zh={p.title} en={p.titleEn} /></h3>
              <p class="rcard-sum"><Tr zh={p.summary} en={p.summaryEn} /></p>
              {p.includes && (
                <ul class="rcard-inc">
                  {p.includes.map((it) => (<li><span class="ck">✓</span> <Tr zh={it.zh} en={it.en} /></li>))}
                </ul>
              )}
              {p.files && (
                <div class="rcard-foot">
                  <p class="rcard-note"><Tr zh="留下名字与邮箱，立即解锁下载（中英 PDF）。" en="Leave your name & email to unlock the download (bilingual PDF)." /></p>
                  <div class="subscribe-wrap free-dl">
                    <form class="js-subscribe subscribe-inline" data-endpoint={endpoint} data-source={"free-" + p.slug}>
                      <input type="hidden" name="source" value={"free-" + p.slug} />
                      <input class="sub-name" type="text" name="name" placeholder="你的名字" data-ph-en="Your name" required autocomplete="name" />
                      <input class="sub-email" type="email" name="email" placeholder="@email.com" data-ph-en="@email.com" required autocomplete="email" />
                      <button type="submit"><Tr zh="免费下载" en="Get it free" /></button>
                    </form>
                    <p class="form-msg" role="status" aria-live="polite"></p>
                    <div class="dl-reveal" style="display:none">
                      <p class="dl-ready"><Tr zh="✓ 搞定！点下面下载：" en="✓ Done! Download below:" /></p>
                      <div class="dl-btns">
                        <a class="support-btn" href={p.files.zh} download="">中文版 PDF</a>
                        <a class="support-btn" href={p.files.en} download="">English PDF</a>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-note reveal"><Tr zh="免费资料正在制作中，敬请期待。" en="Free resources are in the works — stay tuned." /></p>
    )}

    <div class="res-footer-note reveal">
      <a class="res-also-link" href="/resources/paid">
        <Tr zh="也看看付费深度手册 →" en="Check out our in-depth paid guides →" />
      </a>
    </div>

  </div>
</Base>

<style>
.res-hero { padding: 1.5rem 0 1.5rem; }
.res-hero h1 { font-size: 2.2rem; margin: 0.6rem 0 0.5rem; letter-spacing: -0.02em; }
.res-hero p { color: var(--soft); font-size: 1.02rem; max-width: 48rem; line-height: 1.75; margin: 0; }
.res-sub-badge {
  display: inline-block; font-size: 0.82rem; font-weight: 700;
  background: #e6f4ee; color: #1a7f4b; border: 1px solid #b2dfc5;
  padding: 0.3rem 0.85rem; border-radius: 99px; margin-bottom: 0.6rem;
}
.res-footer-note { margin: 2.5rem 0 1rem; text-align: center; }
.res-also-link {
  color: var(--accent); font-weight: 700; text-decoration: none; font-size: 0.97rem;
}
.res-also-link:hover { text-decoration: underline; }
</style>
