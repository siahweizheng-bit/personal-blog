---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Tr from '../components/Tr.astro';
import { site } from '../config.js';

const m = site.membership || {};
const perks = m.perks || [];
---

<Base title="会员" description={`成为 ${site.name} 会员，支持独立公民教育`}>
  <div class="wrap-read" style="padding-top:2rem">
    <!-- 页头面板 -->
    <header class="mem-hero">
      <span class="hero-kicker"><Tr zh="会员 · MEMBERSHIP" en="MEMBERSHIP" /></span>
      <h1><Tr zh="成为会员，把公民教育撑下去" en="Become a member — keep civic education going" /></h1>
      <p><Tr
        zh="网站文章永远免费。会员是给愿意更进一步的人——每周两篇会员专属深度文章，直接送到你的信箱。你的月费让我们保持独立、只对读者负责。"
        en="Our articles stay free. Membership is for those who want to go further — two in-depth members-only articles each week, straight to your inbox. Your monthly support keeps us independent and accountable only to readers."
      /></p>
    </header>

    <!-- 定价卡 -->
    <div class="plan-card">
      <div class="plan-head">
        <span class="plan-name"><Tr zh="会员" en="Member" /></span>
        <div class="plan-price">
          <span class="amount">{m.priceMonthly}</span>
          <span class="per"><Tr zh="/ 月" en="/ month" /></span>
        </div>
        {m.priceNote && <span class="plan-note"><Tr zh={m.priceNote} en="Cancel anytime" /></span>}
      </div>
      <ul class="plan-perks">
        {perks.map((k) => (
          <li><span class="check">✓</span> <Tr zh={k.zh} en={k.en} /></li>
        ))}
        <li><span class="check">✓</span><Tr zh="支持独立、中立、零广告的公民教育" en="Support independent, neutral, ad-free civic education" /></li>
      </ul>
      <a class="plan-btn plan-cta" href="#join"><Tr zh="立即申请会员 →" en="Apply now →" /></a>
      <p class="plan-fine"><Tr zh="手动 DuitNow 收款 · 可随时取消 · 无隐藏费用" en="Manual DuitNow · cancel anytime · no hidden fees" /></p>
    </div>

    <!-- 加入流程（DuitNow 手动） -->
    <h2 class="section-title" style="margin-top:2.6rem"><Tr zh="怎么加入（3 步）" en="How to join (3 steps)" /></h2>
    <div class="join-steps">
      <div class="join-step">
        <span class="js-n">1</span>
        <h4><Tr zh="填下面的表格" en="Fill in the form" /></h4>
        <p><Tr zh="留下名字和常用 email，告诉我们你想加入会员。" en="Leave your name and email to tell us you'd like to join." /></p>
      </div>
      <div class="join-step">
        <span class="js-n">2</span>
        <h4><Tr zh="收 DuitNow 二维码" en="Get a DuitNow QR" /></h4>
        <p><Tr zh="我们会 email 给你 DuitNow 收款码，扫码付月费即可。" en="We'll email you a DuitNow QR — scan and pay the monthly fee." /></p>
      </div>
      <div class="join-step">
        <span class="js-n">3</span>
        <h4><Tr zh="开始收会员文章" en="Start receiving articles" /></h4>
        <p><Tr zh="确认收款后，每周两篇专属文章直接送到你的信箱。" en="Once confirmed, two articles a week land in your inbox." /></p>
      </div>
    </div>

    <!-- 会员申请表（写入 Google 表格 Members 工作表） -->
    <div class="member-form-box" id="join">
      <span class="mfb-badge">★ <Tr zh="会员申请" en="Membership" /></span>
      <h3><Tr zh="申请成为会员" en="Apply to become a member" /></h3>
      <p class="mfb-sub">
        <Tr zh="提交后请留意邮箱，我们会把 DuitNow 付款方式发给你。" en="After submitting, watch your inbox — we'll send you the DuitNow payment details." />
      </p>
      <SubscribeForm variant="inline" source="member" cta="申请会员" ctaEn="Apply now" />
    </div>

    <p class="resources-note">
      <Tr
        zh="提醒：核心公民知识——宪法、权利、投票流程——永远免费、不设付费墙。会员解锁的是每周的深度内容。"
        en="Note: core civic knowledge — the Constitution, your rights, how to vote — stays free, never paywalled. Membership unlocks the weekly in-depth content."
      />
    </p>

    <h2 class="section-title" style="margin-top:2.6rem"><Tr zh="还没准备好？先订阅免费的" en="Not ready? Subscribe free first" /></h2>
    <SubscribeForm variant="inline" source="subscribe" />
  </div>
</Base>
